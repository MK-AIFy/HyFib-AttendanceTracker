@page "/admin/violations"
@attribute [Authorize(Roles = "SuperAdmin,Admin,HRManager,Manager")]
@layout AttendTrack.Web.Layouts.MainLayout

<h4 class="mb-4"><i class="bi bi-exclamation-triangle me-2"></i>Shift Violations</h4>

<div class="mb-3 d-flex align-items-center gap-3 flex-wrap">
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">From:</label>
        <input type="date" class="form-control form-control-sm" @bind="_from" @bind:format="yyyy-MM-dd" />
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">To:</label>
        <input type="date" class="form-control form-control-sm" @bind="_to" @bind:format="yyyy-MM-dd" />
    </div>
    <button class="btn btn-primary btn-sm" @onclick="LoadDataAsync">
        <i class="bi bi-search"></i> Load
    </button>
    @if (_violations.Count > 0)
    {
        <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsv">
            <i class="bi bi-download"></i> Export CSV
        </button>
    }
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (!_searched)
{
    <div class="alert alert-light border">
        <i class="bi bi-info-circle me-1"></i>
        Pick a date range and click <strong>Load</strong> to view shift violations.
    </div>
}
else if (_violations.Count == 0 && _searched)
{
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>No shift violations in the selected period.</div>
}
else
{
    <div class="card">
        <div class="card-header fw-semibold d-flex justify-content-between">
            Violations
            <span class="badge bg-danger">@_violations.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Employee</th>
                        <th>Check-In (IST)</th>
                        <th>Check-Out (IST)</th>
                        <th>Violation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _violations)
                    {
                        <tr class="table-warning">
                            <td>@v.WorkDate</td>
                            <td>
                                @v.EmployeeName
                                <br /><span class="text-muted small">@v.EmployeeCode</span>
                            </td>
                            <td>@(v.CheckInTimeIst ?? "—")</td>
                            <td>@(v.CheckOutTimeIst ?? "—")</td>
                            <td>
                                <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                                @v.Notes
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
