@page "/admin/shifts"
@attribute [Authorize(Roles = "SuperAdmin,Admin,HRManager,Manager")]
@layout AttendTrack.Web.Layouts.MainLayout
@using AttendTrack.Domain.Entities

<h4 class="mb-4"><i class="bi bi-clock-history me-2"></i>Shifts</h4>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowAddModal">
        <i class="bi bi-plus-circle"></i> Add Shift
    </button>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Name</th><th>Start</th><th>End</th><th>Grace</th><th>OT Threshold</th><th>Night</th><th>Active</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _shifts)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Name</td>
                            <td>@s.StartTime.ToString("hh:mm tt")</td>
                            <td>@s.EndTime.ToString("hh:mm tt")</td>
                            <td>@s.GracePeriodMinutes min</td>
                            <td>@s.OvertimeThresholdMinutes min</td>
                            <td>@(s.IsNightShift ? "Yes" : "No")</td>
                            <td>@(s.IsActive ? "✓" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_showModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Shift</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_formError))
                    { <div class="alert alert-danger py-1">@_formError</div> }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Name *</label>
                            <input class="form-control" @bind="_fName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Time (HH:mm) *</label>
                            <input class="form-control" @bind="_fStart" placeholder="09:00" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Time (HH:mm) *</label>
                            <input class="form-control" @bind="_fEnd" placeholder="18:00" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Grace Period (min)</label>
                            <input class="form-control" type="number" @bind="_fGrace" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">OT Threshold (min)</label>
                            <input class="form-control" type="number" @bind="_fOt" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAsync">Create</button>
                </div>
            </div>
        </div>
    </div>
}

