@page "/employee/timesheets"
@attribute [Authorize]
@layout AttendTrack.Web.Layouts.MainLayout

<h4 class="mb-4"><i class="bi bi-table me-2"></i>My Timesheets</h4>

<ErrorBanner Message="@_error" />

<div class="mb-3 d-flex align-items-center gap-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick="PrevWeek">
        <i class="bi bi-chevron-left"></i>
    </button>
    <span class="fw-semibold">Week of @_weekStart.ToString("dd MMM yyyy")</span>
    <button class="btn btn-outline-secondary btn-sm" @onclick="NextWeek">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Check In</th><th>Check Out</th><th>Hours</th><th>Break</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in _records)
                    {
                        <tr>
                            <td>@r.WorkDate</td>
                            <td>@(r.CheckInTimeIst ?? "—")</td>
                            <td>@(r.CheckOutTimeIst ?? "—")</td>
                            <td>@r.TotalHoursWorked.ToString("F1")</td>
                            <td>@r.BreakDurationMinutes min</td>
                            <td><span class="badge @StatusBadge(r.Status)">@r.Status</span></td>
                        </tr>
                    }
                    @if (_records.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No records for this week</td></tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th>Total</th>
                        <td colspan="2"></td>
                        <th>@_records.Sum(r => r.TotalHoursWorked).ToString("F1") h</th>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

