<?xml version="1.0" encoding="utf-8"?>
<!--
  AttendTrack Enterprise — IIS hosting configuration (Phase 5).

  Hosting model: in-process via AspNetCoreModuleV2 (installed by the
  ASP.NET Core 9 Hosting Bundle). The bundle ships with `dotnet.exe`
  in the system PATH so `processPath="dotnet"` resolves correctly.

  This file is published next to AttendTrack.Web.dll. `dotnet publish`
  will overwrite this file by default — keep a copy in source control.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\AttendTrack.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!-- Block the .NET runtime config files from being served -->
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="bin" />
            <add segment="logs" />
          </hiddenSegments>
          <fileExtensions>
            <add fileExtension=".config" allowed="false" />
            <add fileExtension=".cs" allowed="false" />
            <add fileExtension=".csproj" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>

      <!-- Defence-in-depth: ensure WebSocket upgrade works for SignalR.
           Security headers are set by SecurityHeadersMiddleware in code. -->
      <webSocket enabled="true" />
    </system.webServer>
  </location>
</configuration>
