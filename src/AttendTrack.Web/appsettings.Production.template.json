{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\AttendTrack\\logs\\attendtrack-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=attendtrack;Username=attendtrack;Password=__REPLACE_ME__;Pooling=true;Maximum Pool Size=50",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=2000"
  },
  "Hikvision": {
    "FaceCaptureBasePath": "C:\\AttendTrack\\face-captures",
    "IsapiTimeoutSeconds": 10
  },
  "Jwt": {
    "SecretKey": "__REPLACE_WITH_RANDOM_BASE64_AT_LEAST_32_CHARS__",
    "Issuer": "AttendTrack",
    "Audience": "AttendTrackUsers",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "https://attendtrack.local" ]
  },
  "Kiosk": {
    "AllowedIpRanges": [
      "192.168.1.0/24"
    ]
  },
  "AllowedHosts": "*"
}
