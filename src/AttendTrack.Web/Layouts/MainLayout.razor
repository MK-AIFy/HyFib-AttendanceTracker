@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
<div class="d-flex vh-100">
    <!-- Sidebar -->
    <nav class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width:240px;">
        <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="bi bi-fingerprint fs-4 me-2"></i>
            <span class="fs-5 fw-semibold">AttendTrack</span>
        </a>
        <hr />
        <ul class="nav nav-pills flex-column mb-auto">
            <AuthorizeView Roles="SuperAdmin,Admin,HRManager,Manager">
                <Authorized>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/dashboard" Match="NavLinkMatch.All">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/live">
                            <i class="bi bi-activity me-2"></i>Live Attendance
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/employees">
                            <i class="bi bi-people me-2"></i>Employees
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/devices">
                            <i class="bi bi-cpu me-2"></i>Biometric Devices
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/heatmap">
                            <i class="bi bi-grid-3x3-gap me-2"></i>Hourly Heat Map
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/violations">
                            <i class="bi bi-exclamation-triangle me-2"></i>Shift Violations
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/reports">
                            <i class="bi bi-file-earmark-bar-graph me-2"></i>Reports
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin/shifts">
                            <i class="bi bi-clock me-2"></i>Shifts
                        </NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item mt-3">
                        <small class="text-secondary text-uppercase">My Workspace</small>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/employee/my-attendance">
                            <i class="bi bi-calendar-check me-2"></i>My Attendance
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/employee/timesheets">
                            <i class="bi bi-table me-2"></i>My Timesheets
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/employee/my-data">
                            <i class="bi bi-shield-check me-2"></i>My Data (DPDP)
                        </NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>
        </ul>
        <hr />
        <AuthorizeView>
            <Authorized>
                <div class="small text-secondary mb-2">
                    <i class="bi bi-person-circle me-1"></i>@context.User.Identity?.Name
                </div>
                <form method="post" action="/auth/logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-sm btn-outline-light w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>Sign out
                    </button>
                </form>
            </Authorized>
        </AuthorizeView>
        <div class="small text-secondary mt-2">v2.3 · MAS Data Center</div>
    </nav>
    <!-- Main content -->
    <main class="flex-grow-1 overflow-auto bg-light">
        <div class="p-4">
            @Body
        </div>
    </main>
</div>
