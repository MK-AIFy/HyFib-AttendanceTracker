## Standard .NET gitignore

# Build outputs
bin/
obj/
out/
publish/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/
*.DotSettings.user

# dotnet CLI
*.swp
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
nuget.config.user

# ASP.NET
# Real per-environment secrets are excluded; the checked-in Production
# *template* (marker tokens only, no real secrets) must stay tracked.
appsettings.*.json
!appsettings.Development.json
!appsettings.Production.template.json

# Environment secrets
.env
.env.*
!.env.example
secrets.json

# AttendTrack-specific exclusions
/backups/
/face-captures/
/app/face-captures/
/app/logs/

# Test results
TestResults/
*.trx
*.coverage
coverage/

# Logs
*.log
logs/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Docker
docker-compose.override.yml

# IDE temp
*.tmp
*.bak
